# Virtual environment
venv/

#SQLite
db.sqlite3

#pycache
*__pycache__*

#uploads
*/uploads/*

#static files
/static/

# media files
*media*

#logs
*.log

# private file for secret data
private.py
.claude/settings.local.json

# Local development settings file for environment variables
settings.ini

# Deployment environment file. This lives INSIDE the repo checkout on the
# servers (systemd reads /var/www/<deployment>/repo/.env), so it must never be
# committable: it holds SECRET_KEY, the database password and the ABRA token.
.env
.env.*
!.env.example